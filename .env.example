# Local development only. Copy to .env (git-ignored) and replace every value.
# Generate random values with: openssl rand -base64 32
LOCAL_DB_PASSWORD=
LOCAL_DIRECTUS_SECRET=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# Nuxt (apps/web) reads this when running `corepack pnpm dev`.
NUXT_DATABASE_URL=postgres://obiou:<LOCAL_DB_PASSWORD>@localhost:5433/obiou_sommets
