{
  "name": "obiou-sommets",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "lint": "pnpm -r --no-bail lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm coverage:patch",
    "coverage:patch": "node scripts/patch-coverage.mjs --base origin/main"
  },
  "devDependencies": {
    "railway": "^3.11.0",
    "typescript": "^6.0.3"
  }
}
